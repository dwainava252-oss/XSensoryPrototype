<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRESSED STATE -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#1A7A1A"
                        android:centerColor="#1A6B1A"
                        android:endColor="#145214"
                        android:centerX="0.5"
                        android:angle="270"/>
                    <corners android:radius="10dp"/>
                    <stroke android:width="1dp" android:color="#0F4A0F"/>
                </shape>
            </item>
            <item
                android:bottom="22dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#5ABA5A"
                        android:endColor="#2A8C2A"
                        android:angle="270"/>
                    <corners android:radius="9dp"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- NORMAL STATE -->
    <item>
        <layer-list>

            <!-- Base body -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#4CC24A"
                        android:endColor="#2FA437"
                        android:angle="270"/>
                    <corners android:radius="10dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#1C6B1C"/>
                </shape>
            </item>

            <!-- Gloss highlight -->
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="26dp">

                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#AAFFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="270"/>
                    <corners android:radius="9dp"/>
                </shape>

            </item>

        </layer-list>
    </item>

</selector>
