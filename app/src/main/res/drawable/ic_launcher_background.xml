<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base diagonal gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0"   android:startY="108"
                android:endX="108"   android:endY="0">
                <item android:offset="0.0"  android:color="#FF1A8A20"/>
                <item android:offset="0.35" android:color="#FF0E9A70"/>
                <item android:offset="0.70" android:color="#FF0B6EC4"/>
                <item android:offset="1.0"  android:color="#FF0848A8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Aurora lime sweep -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0"   android:startY="108"
                android:endX="108"   android:endY="0">
                <item android:offset="0.0"  android:color="#00C8F020"/>
                <item android:offset="0.30" android:color="#8C80E830"/>
                <item android:offset="0.55" android:color="#4040D860"/>
                <item android:offset="1.0"  android:color="#0000C0A0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-right blue highlight -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="108" android:startY="0"
                android:endX="0"     android:endY="108">
                <item android:offset="0.0"  android:color="#7288DDFF"/>
                <item android:offset="1.0"  android:color="#0088DDFF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rays fanning from top-left (-10,-10), wider + less opaque -->
    <path android:pathData="M-10,-10 L120,130"
        android:strokeColor="#FFFFFF" android:strokeWidth="55"
        android:strokeAlpha="0.055" android:fillColor="#00000000"
        android:strokeLineCap="round"/>
    <path android:pathData="M-10,-10 L80,130"
        android:strokeColor="#FFFFFF" android:strokeWidth="36"
        android:strokeAlpha="0.048" android:fillColor="#00000000"
        android:strokeLineCap="round"/>
    <path android:pathData="M-10,-10 L40,130"
        android:strokeColor="#FFFFFF" android:strokeWidth="22"
        android:strokeAlpha="0.042" android:fillColor="#00000000"
        android:strokeLineCap="round"/>
    <path android:pathData="M-10,-10 L120,88"
        android:strokeColor="#FFFFFF" android:strokeWidth="44"
        android:strokeAlpha="0.045" android:fillColor="#00000000"
        android:strokeLineCap="round"/>
    <path android:pathData="M-10,-10 L120,52"
        android:strokeColor="#FFFFFF" android:strokeWidth="20"
        android:strokeAlpha="0.038" android:fillColor="#00000000"
        android:strokeLineCap="round"/>

    <!-- Gloss sheen top half -->
    <path android:pathData="M0,0h108v54h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54"   android:endY="54">
                <item android:offset="0.0" android:color="#45FFFFFF"/>
                <item android:offset="1.0" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>