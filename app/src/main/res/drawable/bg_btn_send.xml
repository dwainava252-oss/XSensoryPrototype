<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    ```
    <!-- PRESSED STATE -->
    <item android:state_pressed="true">
        <layer-list>

            <!-- Base -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#EF5E0A"
                        android:endColor="#BF4B0B"
                        android:angle="270"/>
                    <corners android:radius="10dp"/>
                    <stroke android:width="1dp" android:color="#973B07"/>
                </shape>
            </item>

            <!-- Gloss -->
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="26dp">

                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="270"/>
                    <corners android:radius="9dp"/>
                </shape>

            </item>

        </layer-list>
    </item>


    <!-- NORMAL STATE -->
    <item>
        <layer-list>

            <!-- Base -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#EF5E0A"
                        android:endColor="#BF4B0B"
                        android:angle="270"/>
                    <corners android:radius="10dp"/>
                    <stroke android:width="1dp" android:color="#973B07"/>
                </shape>
            </item>

            <!-- Gloss highlight -->
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="26dp">

                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#AAFFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="270"/>
                    <corners android:radius="9dp"/>
                </shape>

            </item>

        </layer-list>
    </item>
    ```

</selector>
