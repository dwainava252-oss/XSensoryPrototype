<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page"
    android:padding="16dp">

    <!-- TITLE BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_titlebar"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_xsensory_share"
            android:layout_marginEnd="10dp"
            android:contentDescription="XSensory logo"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XSensory"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.04"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File Share"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"/>

    </LinearLayout>

    <!-- STATUS CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap Discover to find nearby devices"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.3"/>

    </LinearLayout>

    <!-- PROGRESS ROW -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transferring…"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/neon_green"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:progressDrawable="@drawable/bg_progress"
            android:max="100"/>

    </LinearLayout>

    <!-- DISCOVER button — shown at start, hidden after connection -->
    <Button
        android:id="@+id/btnDiscover"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="DISCOVER DEVICES"
        android:textColor="@color/bg_page"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:background="@drawable/bg_btn_discover"
        android:layout_marginBottom="8dp"
        android:visibility="visible"/>

    <!-- SEND FILE button — shown only when role = Sender -->
    <Button
        android:id="@+id/btnSendFile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="SEND FILE"
        android:textColor="@color/bg_page"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:background="@drawable/bg_btn_discover"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- RECEIVE button — shown only when role = Receiver -->
    <Button
        android:id="@+id/btnReceive"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="RECEIVE FILE"
        android:textColor="@color/neon_green"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:background="@drawable/bg_btn_receive"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- DISCONNECT button — shown after connection forms -->
    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="DISCONNECT"
        android:textColor="@color/color_danger"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:background="@drawable/bg_btn_disconnect"
        android:layout_marginBottom="14dp"
        android:visibility="gone"/>

    <!-- RADAR — fills the remaining space; taps on a blip connect to that peer -->
    <com.k2e7.xsensory.views.RadarView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"/>

</LinearLayout>